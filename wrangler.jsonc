{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awesome-aeco-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "routes": [
    {
      "pattern": "mcp.awesome-aeco.org",
      "custom_domain": true
    }
  ],
  "vars": {
    "CATALOG_URL": "https://awesome-aeco.org/data/catalog.json"
  }
}
